# ============================================================================
# Spark — environment template.  Copy to `.env` and fill in.  NEVER commit .env.
# Secrets belong in a secrets manager in any deployed environment; this file
# documents the variables the app reads.
# ============================================================================

# ---- Database (PostgreSQL 16) ----------------------------------------------
# DATABASE_URL is used by Prisma migrate/seed and by the API.  It should point
# at a role that OWNS the schema (needed to run migrations & toggle RLS).
DATABASE_URL="postgresql://spark_owner:CHANGE_ME@localhost:5432/spark?schema=public"

# APP_DATABASE_URL is the *runtime* connection the API uses for tenant queries.
# It MUST be a non-owner, non-superuser role so Row-Level Security is enforced
# (Postgres exempts table owners & superusers from RLS).  See packages/db/prisma/rls.sql.
APP_DATABASE_URL="postgresql://spark_app:CHANGE_ME@localhost:5432/spark?schema=public"

# ---- Redis (BullMQ jobs / scheduling / rate limits / kill switch) ----------
REDIS_URL="redis://localhost:6379"

# ---- Auth (Auth.js / NextAuth) — wired up in a later epic --------------------
AUTH_SECRET="generate-with: openssl rand -base64 32"
AUTH_URL="http://localhost:3000"
# SSO providers (optional; created by the user, never auto-provisioned)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""

# ---- Token encryption (third-party OAuth tokens are encrypted at rest) ------
# 32-byte key, base64.  Used to encrypt values in the `connections` table.
TOKEN_ENCRYPTION_KEY="generate-with: openssl rand -base64 32"

# ---- LLM provider (provider-abstracted; configurable per workspace) ---------
LLM_PROVIDER="stub"          # stub | anthropic | openai | ...
LLM_API_KEY=""
LLM_DEFAULT_MODEL="claude-sonnet-4-6"

# ---- Integrations (all behind adapters; stubs run without credentials) ------
# WordPress, Squirrly/RankMath/Yoast, Nifty, GSC, GA4, Uniple, YouTube.
# Per-workspace credentials live (encrypted) in the `connections` table — these
# are only global/dev fallbacks where an adapter needs a default.
WORDPRESS_DEFAULT_BASE_URL=""
NIFTY_API_BASE_URL="https://openapi.niftypm.com/api/v1.0"
GOOGLE_OAUTH_CLIENT_ID=""     # GSC + GA4 read access
GOOGLE_OAUTH_CLIENT_SECRET=""
UNIPLE_API_BASE_URL=""        # confirm before finalizing adapter (see FR-12)
YOUTUBE_API_KEY=""

# ---- Ports ------------------------------------------------------------------
API_PORT="4000"
WEB_PORT="3000"

# ---- Runtime ----------------------------------------------------------------
NODE_ENV="development"
